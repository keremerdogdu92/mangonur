# Mangonur provider credential template.
# Copy this file to .env.local and fill only the providers you intend to use.
# Never commit .env.local or real API credentials.

# Z.AI / BigModel - CogVideoX video generation
ZAI_API_KEY=

# Cloudflare Workers AI - image generation and transcription
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ModelScope API Inference - image editing / reference-aware generation
MODELSCOPE_ACCESS_TOKEN=

# NVIDIA NIM - multimodal quality control and optional AI services
NVIDIA_API_KEY=

# Optional language-model providers already supported by the wider workflow
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GEMINI_API_KEY=
